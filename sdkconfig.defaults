# Project-wide defaults, shared by ALL targets. Checked into git so builds are
# reproducible; the generated sdkconfig (machine-specific) is gitignored.
#
# NOTE: the target chip is intentionally NOT pinned here. Selecting it with
# `idf.py set-target <chip>` is authoritative, which is what lets this one
# project build for multiple variants (see tools/targets.sh). Per-target
# overrides, if ever needed, go in sdkconfig.defaults.<target>.

# --- Debugging aids useful for RTOS learning (cheap, keep on in dev) ---
# Detect task stack overflows (method 2 = canary + SP check).
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
# Record task high-water marks so we can inspect stack usage.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
